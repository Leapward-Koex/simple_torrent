.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# The workspace owns the only Dart/Flutter lockfile. Package-local lockfiles
# remain ignored so every member resolves against the same dependency graph.
/packages/**/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

/build_scripts/toolchains/

# Maintainer-only native source/download cache. Release artifacts are staged
# into the platform packages and tracked through Git LFS.
.native-cache/
