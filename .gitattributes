# Bundled release artifacts for the federated platform packages.
packages/simple_torrent_android/android/src/main/jniLibs/**/*.so filter=lfs diff=lfs merge=lfs -text
packages/simple_torrent_windows/windows/lib/**/*.dll filter=lfs diff=lfs merge=lfs -text
packages/simple_torrent_windows/windows/lib/**/*.lib filter=lfs diff=lfs merge=lfs -text
packages/simple_torrent_ios/ios/simple_torrent_ios/Frameworks/**/*.a filter=lfs diff=lfs merge=lfs -text
packages/simple_torrent_macos/macos/simple_torrent_macos/Frameworks/**/*.a filter=lfs diff=lfs merge=lfs -text

# Preserve shell scripts with Unix line endings on every maintainer host.
*.sh text eol=lf
/native/patches/*.patch text eol=lf

# Native bundle manifests hash public headers byte-for-byte. Keep their bytes
# stable when a bundle is built on Windows and published from a Unix runner.
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
